%% CLIENTE: módulos já validados.
namespace Cliente {
  class Application
  class Students
  class Goals
  class StudentService["Student Service"]
  class Email
  class ConfiguracaoLembretesCliente["Configuração de lembretes"]
  class HistoricoNotificacoesCliente["Histórico de notificações"]
  class EmailService["Email Service"]
}

class Interface["Interface (i)"]

%% SERVIDOR: base do professor e extensões validadas.
namespace Servidor {
  class Services {
    addStudent()
    removeStudent()
    synchronize()
    definirPrazoAcademico(ano, semestre, novoPrazo) String
    configurarLembretes(turma, quantidade, lembretesPropostos) String
    consultarConfiguracaoLembretes(turma)
    consultarHistorico()
    filtrarHistorico(disciplina, turma)
    consultarDetalhesNotificacao(idNotificacao)
  }
  class StudentListImport["StudentList Import"]
  class StudentList {
    add(Student)
    remove(Student)
  }
  class Student {
    name
    email
  }
  class GradesImportService["Grades Import Service"]
  class Classes {
    emailDasTurmas
    obterEmailDasTurmas()
    definirEmailDasTurmas(email)
    validarEmailDasTurmas(email)
    buscar(turma) Class
    buscarPorPeriodo(ano, semestre) Class[]
  }
  class Class {
    semester
    obterPeriodoAcademico() PeriodoAcademico
    obterConfiguracaoLembretes() ConfiguracaoLembretes
    identificarPendencias()
  }
  class PeriodoAcademico {
    ano
    semestre
    prazoAcademico
    prazoEncerrado(instanteAtual) boolean
    definirPrazoAcademico(novoPrazo, instanteAtual, configuracoesDoPeriodo)
  }
  class Enrolment {
    getEvaluationForGoal(meta)
    getEvaluations() Evaluation[]
  }
  class Evaluation {
    goal
    grade
  }
  class GradeNotification["Grade Notification"]
  class EmailSender {
    send(String[])
    send(destinatario, assunto, conteudo) ResultadoEnvio
  }
  class EmailSenderSmtp {
    send(destinatario, assunto, conteudo) Promise~ResultadoEnvio~
  }
  class ResultadoEnvio {
    boolean aceito
    String descricaoFalha
  }
  class ConfiguracaoLembretes {
    add(Lembrete)
    remove(Lembrete)
    marcarComoEnviado(id)
    atualizar(quantidade, lembretesPropostos, instanteAtual, prazoAcademico)
    possuiAgendamentosPendentesApos(novoPrazo) boolean
    buscarLembretesPara(data, horario) Lembrete[]
    listar() Lembrete[]
  }
  class Lembrete {
    id
    data
    horário
    estado
    motivo
    proximoReenvioEm
    reagendar(novaData, novoHorario, instanteAtual, prazoAcademico)
    jaFoiEnviado() boolean
    marcarComoEnviado()
    ignorar(motivo)
    cancelar(motivo)
    programarReenvio(dataHora)
  }
  class NotificacaoService["NotificaçãoService"] {
    montarEmailNotasPendentes(turma, destinatario, prazoAcademico)
    processar(Lembrete)
    processarAgendados(turma, data, horario)
    processarReenvios(turma)
    calcularProximoReenvio(lembrete, instanteAtual)
  }
  class HistoricoNotificacoes {
    registrar(Notificacao)
    listar() Notificacao[]
    filtrar(disciplina, turma) Notificacao[]
    buscar(idNotificacao)
  }
  class Notificacao {
    id
    lembreteId
    nomeDestinatario
    turmaRegistrada
    dataHora
    resultado
    motivo
    descricaoFalha
    pendenciasRegistradas
    prazoRegistrado
  }
  note for Notificacao "resultado:<br/>Enviado/Falha: tentativa de envio.<br/>Ignorado: processamento sem envio."
}

